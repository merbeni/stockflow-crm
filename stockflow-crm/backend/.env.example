DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/stockflow
GOOGLE_API_KEY=your_google_ai_studio_api_key
SECRET_KEY=your_secret_key_for_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# SendGrid — optional, emails are silently skipped if not set
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Orígenes permitidos por CORS, separados por coma.
# Nunca uses "*" en producción: es incompatible con el envío de credenciales.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL pública del frontend. Se usa para armar el enlace de verificación
# de correo que se envía al registrarse.
FRONTEND_URL=http://localhost:5173
